// This is your Prisma schema file,
// learn more about the docs here: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Key-value store for editable site content (CMS).
/// `key = "site"` holds a JSON blob of the full SiteSettings object.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Admin account (single admin, username "admin").
/// The password is stored as a bcrypt hash — never in plain text.
model AdminUser {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
}

/// Server-side admin sessions: random token (hashed) + expiry + revocation.
model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Product {
  id            String      @id @default(cuid())
  name          String      @unique
  description   String
  /** Optional FR / AR translations — storefront falls back to the base fields. */
  nameFr        String?
  descriptionFr String?
  nameAr        String?
  descriptionAr String?
  price         Int
  oldPrice      Int?
  category      String
  brand         String      @default("Proxima")
  image         String
  stock         Int         @default(10)
  featured      Boolean     @default(false)
  badge         String?
  rating        Float       @default(4.5)
  reviewsCount  Int         @default(0)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

/// Uploaded product images (admin "Upload image" button).
/// Stored compressed (WebP ≤ 1200px) — served by /api/images/[id].
/// Works on Vercel's read-only filesystem (no local disk writes needed).
model ImageAsset {
  id        String   @id @default(cuid())
  mime      String   @default("image/webp")
  data      Bytes
  createdAt DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  wilaya       String
  address      String?
  notes        String?
  subtotal     Int
  deliveryFee  Int         @default(0)
  total        Int
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  price        Int
  quantity     Int
}
