# ── Proxima Elec ────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# (.env is git-ignored — your real secrets never reach GitHub.)

# Local SQLite database (development).
# Path is relative to prisma/schema.prisma → points at <project>/db/custom.db
DATABASE_URL=file:../db/custom.db

# Hosted Postgres (production on Vercel — e.g. a free Neon database):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Admin password for the /admin panel.
# Local default below; on Vercel set a STRONG one in Environment Variables.
# The account is created (bcrypt-hashed) on first login; change it right
# after from Admin → Content → Security.
ADMIN_PASSWORD=proxima2025

# Public site URL (SEO / OpenGraph metadata).
# NOTE: baked in at build time — changing it later requires a redeploy.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
